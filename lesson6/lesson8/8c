<!DOCTYPE html>
<html>
<head>
    <title>8c - Google Search</title>

    <style>
        .google-logo {
            width: 300px;
            display: block;
            margin: 30px auto 20px;
        }

        .search-box {
            width: 600px;
            padding: 15px 20px;
            border-radius: 30px;
            border: 1px solid #ccc;
            font-size: 18px;
            display: block;
            margin: auto;
            box-shadow: 0px 2px 8px #ddd;
        }
    </style>
</head>

<body>

    <img class="google-logo"
         src="https://www.google.com/images/branding/googlelogo/1x/googlelogo_color_272x92dp.png">

    <input
        class="search-box"
        type="text"
        placeholder="Search Google or type a URL">

</body>
</html>